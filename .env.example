# ---------------------------------------------------------------------------
# Autonomous Job Description & Resume Matcher Agent — environment variables
# Copy this file to ".env" and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- LLM Provider Selection ---
# Options: 'gemini' (Recommended - 100% Free), 'groq' (Free & Fast), 'claude' (Paid), 'ollama' (Local)
LLM_PROVIDER=gemini

# Google Gemini API key (100% FREE without credit card: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API key (FREE fast open-source models: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude API key (Paid: https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# Max tokens for each agent completion
ANTHROPIC_MAX_TOKENS=2048

# FastAPI backend host/port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of origins allowed to call the API (CORS).
# Include the Streamlit dev server origin.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Base URL the Streamlit frontend uses to reach the FastAPI backend
BACKEND_URL=http://localhost:8000

# spaCy model to load
SPACY_MODEL=en_core_web_sm

# Max upload size for resume PDFs, in megabytes
MAX_UPLOAD_MB=10
